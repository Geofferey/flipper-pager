# Two apps out of one tree. The receiver is the main one; transmitting lives in
# its own .fap so neither carries the other's code, and they hand over by
# queueing each other with the loader and exiting - only one is ever resident.
#
# "*.c" rather than fbt's default "*.c*": the glob recurses either way, but the
# default also matches the .cpython-*.pyc files the host tests leave behind and
# hands them to the linker as linker scripts. Entries starting with "!" exclude.
PCSG_SOURCES = ["*.c"]

# Each app drops the other half. The receiver loses the encoders and the four
# transmit scenes; transmitting loses the decoder, the protocol registry that
# pulls it in, the sampler, the history and log, and the receiver's views and
# scenes. What is left in both is the shell: app, settings, scene manager,
# radio setup and the shared input scenes.
PCSG_RX_ONLY = [
    "!flex_tx.c",
    "!pocsag_tx.c",
    "!pocsag_pager_scene_tx_config.c",
    "!pocsag_pager_scene_tx_confirm.c",
    "!pocsag_pager_scene_tx_ric_input.c",
    "!pocsag_pager_scene_tx_message_input.c",
]
PCSG_TX_ONLY = [
    "!flex.c",
    "!flex_bch.c",
    "!pcsg_generic.c",
    "!pocsag.c",
    "!protocol_items.c",
    "!flex_sampler.c",
    "!pocsag_pager_history.c",
    "!pocsag_pager_log.c",
    "!pocsag_pager_alert.c",
    "!pocsag_pager_led.c",
    # Matches the scene and the view of the same name, which is what we want.
    "!pocsag_pager_receiver.c",
    "!pocsag_pager_receiver_info.c",
    "!pocsag_pager_scene_receiver_config.c",
    "!pocsag_pager_scene_receiver_info.c",
    "!pocsag_pager_scene_review.c",
    "!pocsag_pager_scene_review_info.c",
    "!pocsag_pager_scene_start.c",
    "!pocsag_pager_scene_about.c",
]

App(
    appid="flipper_pager",
    name="Flipper Pager",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="pocsag_pager_app",
    sources=PCSG_SOURCES + PCSG_RX_ONLY,
    requires=["gui"],
    stack_size=4 * 1024,
    order=50,
    fap_icon="flipper_pager_10px.png",
    fap_category="Sub-GHz",
    fap_icon_assets="images",
    # The About text is read from /ext/pager/flipper_pager.txt instead of living in
    # .rodata, where it would occupy RAM for the whole session. Published next
    # to the .fap so the installed copy matches the build.
    fap_extbuild=(
        ExtFile(
            path="${EXT_APPS_WORK_DIR}/flipper_pager.txt",
            command="${PYTHON3} ${FAP_SRC_DIR}/tools/export_about.py "
            "${FAP_SRC_DIR.abspath}/flipper_pager.txt ${TARGET.abspath}",
        ),
    ),
    fap_author="@xMasterX & @Shmuma",
    fap_version="2.0",
    fap_description="Receive and transmit POCSAG and FLEX pager messages on CC1101 supported frequencies.",
)

App(
    appid="flipper_pager_tx",
    name="Flipper Pager TX",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="pocsag_pager_app",
    sources=PCSG_SOURCES + PCSG_TX_ONLY,
    cdefines=["PCSG_TX_APP"],
    requires=["gui"],
    stack_size=4 * 1024,
    order=51,
    fap_icon="flipper_pager_10px.png",
    fap_category="Sub-GHz",
    fap_icon_assets="images",
    # The icon bundle is named after the appid, and the shared sources include
    # flipper_pager_icons.h, so keep that name rather than forking the includes.
    fap_icon_assets_symbol="flipper_pager",
    fap_author="@xMasterX & @Shmuma",
    fap_version="2.0",
    fap_description="Transmit POCSAG and FLEX pager messages. Opened by Flipper Pager.",
)
